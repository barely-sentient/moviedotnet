<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>MovieDotNet</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Produce XML API docs and surface missing public documentation as CS1591. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Show(...) yields Node? and background commands are intentionally not awaited. -->
    <NoWarn>$(NoWarn);CS8604;CS4014;CS8602</NoWarn>
    <DefaultItemExcludes>$(DefaultItemExcludes);builds/**</DefaultItemExcludes>

    <!--
      NuGet is the default path. Developers can still build against the local
      Donkeh checkout with -p:UseLocalDonkeh=true when DonkehRoot exists.
    -->
    <DonkehRoot Condition="'$(DonkehRoot)' == ''">$(MSBuildProjectDirectory)\..\UI Framework\CSS-Engine\Donkeh</DonkehRoot>
    <UseLocalDonkeh Condition="'$(UseLocalDonkeh)' == ''">false</UseLocalDonkeh>
    <DonkehDesktop>true</DonkehDesktop>
    <!-- Opt in with -p:DonkehAndroid=true; desktop builds stay workload-free. -->
    <DonkehAndroid Condition="'$(DonkehAndroid)' == ''">false</DonkehAndroid>

    <!--
      Pick the native LibVLC package by target runtime. Linux uses the distro's
      libvlc (there is no official Linux NuGet native package); macOS and Windows
      get their bundled native runtimes.
    -->
    <MovieDotNetVlcPlatform Condition="'$(RuntimeIdentifier)' == 'win-x64'
        or ('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows')))">windows</MovieDotNetVlcPlatform>
    <MovieDotNetVlcPlatform Condition="'$(RuntimeIdentifier)' == 'osx-x64'
        or '$(RuntimeIdentifier)' == 'osx-arm64'
        or ('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('OSX')))">mac</MovieDotNetVlcPlatform>

    <!-- Copy only the native tree used by the x64 release, not all three. -->
    <VlcWindowsX64Enabled Condition="'$(RuntimeIdentifier)' == 'win-x64'">true</VlcWindowsX64Enabled>
    <VlcWindowsX86Enabled Condition="'$(RuntimeIdentifier)' == 'win-x64'">false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled Condition="'$(RuntimeIdentifier)' == 'win-x64'">false</VlcWindowsArm64Enabled>

    <!-- The Android SDK targets need a JDK; reuse the one the SDK installer placed. -->
    <JavaSdkDirectory Condition="'$(JavaSdkDirectory)' == '' and Exists('$(LOCALAPPDATA)\Android\Jdk')">$(LOCALAPPDATA)\Android\Jdk</JavaSdkDirectory>
    <AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == '' and Exists('$(LOCALAPPDATA)\Android\Sdk')">$(LOCALAPPDATA)\Android\Sdk</AndroidSdkDirectory>
  </PropertyGroup>

  <PropertyGroup Condition="$(TargetFramework.Contains('-android'))">
    <ApplicationId>com.barelysentient.moviedotnet</ApplicationId>
    <ApplicationTitle>MovieDotNet</ApplicationTitle>
  </PropertyGroup>

  <Import Project="$(DonkehRoot)\Build\Donkeh.props" Condition="'$(UseLocalDonkeh)' == 'true'" />

  <PropertyGroup Condition="'$(UseLocalDonkeh)' == 'true'">
    <TargetFrameworks>$(DonkehTargetFrameworks)</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UseLocalDonkeh)' != 'true'">
    <!--
      The NuGet path must opt into Android explicitly. In local mode the
      Donkeh.props import supplies DonkehTargetFrameworks instead.
    -->
    <TargetFrameworks Condition="'$(DonkehAndroid)' == 'true'">net10.0;net10.0-android</TargetFrameworks>
    <TargetFramework Condition="'$(DonkehAndroid)' != 'true'">net10.0</TargetFramework>
    <DonkehVersion Condition="'$(DonkehVersion)' == ''">1.0.31</DonkehVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseLocalDonkeh)' != 'true'">
    <PackageReference Include="Donkeh.Windowing" Version="$(DonkehVersion)" />
  </ItemGroup>

  <!-- Native LibVLC so preview playback works without a separate VLC install. -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-android' and '$(MovieDotNetVlcPlatform)' == 'windows'">
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-android' and '$(MovieDotNetVlcPlatform)' == 'mac'">
    <PackageReference Include="VideoLAN.LibVLC.Mac" Version="3.1.3.2" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
    <PackageReference Include="VideoLAN.LibVLC.Android" Version="3.6.5" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug' and '$(UseLocalDonkeh)' == 'true'">
    <ProjectReference Include="$(DonkehRoot)\HotReload\Source\Donkeh.HotReload.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <EmbeddedResource Update="**/*.css" Watch="false" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="src/Components/TitleBar/TitleBar.css" />
    <EmbeddedResource Include="src/Components/Window/Window.css" />
    <EmbeddedResource Include="src/Components/IconButton/IconButton.css" />
    <EmbeddedResource Include="src/Components/MediaLibrary/MediaLibrary.css" />
    <EmbeddedResource Include="src/Components/PreviewMonitor/PreviewMonitor.css" />
    <EmbeddedResource Include="src/Components/Inspector/Inspector.css" />
    <EmbeddedResource Include="src/Components/Timeline/Timeline.css" />
    <EmbeddedResource Include="src/Components/ExportDialog/ExportDialog.css" />
    <EmbeddedResource Include="src/Components/MediaBrowser/MediaBrowser.css" />
    <EmbeddedResource Include="src/Components/ToastHost/ToastHost.css" />
    <EmbeddedResource Include="src/Components/Choice/Choice.css" />
    <EmbeddedResource Include="src/Styles/theme.css" />
  </ItemGroup>

  <!--
    LibVLCSharp's Core.Initialize() probes the application directory for libvlc.
    The native package lays the runtime out under libvlc/<rid>, so flatten that
    folder next to the executable (and into the publish output) as well.
  -->
  <Target Name="MovieDotNetCopyVlcNatives" AfterTargets="Build" Condition="Exists('$(TargetDir)libvlc\win-x64')">
    <ItemGroup>
      <VlcNative Include="$(TargetDir)libvlc\win-x64\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(VlcNative)" DestinationFolder="$(TargetDir)%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="MovieDotNetCopyVlcNativesPublish" AfterTargets="Publish" Condition="Exists('$(PublishDir)libvlc\win-x64')">
    <ItemGroup>
      <VlcPublishNative Include="$(PublishDir)libvlc\win-x64\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(VlcPublishNative)" DestinationFolder="$(PublishDir)%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
